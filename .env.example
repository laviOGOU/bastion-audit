# ---------------------------------------------------------------------------
# BASTION — variables d'environnement
# Copiez ce fichier en .env et renseignez vos valeurs.
# Le fichier .env ne doit JAMAIS être versionné (voir .gitignore).
# ---------------------------------------------------------------------------

# Clé de signature des sessions. Obligatoire en hébergement.
# Générez-la avec : python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_SECRET_KEY=

# Emplacement du stockage (base de données et fichier de clé).
# En hébergement, pointez vers un volume persistant, sinon la base est
# effacée à chaque redéploiement.
# AUDIT_STORAGE_DIR=/data

# Port d'écoute en local. En hébergement, la variable PORT est fournie
# automatiquement par la plateforme et prime sur celle-ci.
AUDIT_PORT=5002
